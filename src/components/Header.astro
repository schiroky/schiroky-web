---
import { Image } from "astro:assets";
import clausNeon from "../assets/CLAUS-Neon.jpg";

const path = Astro.url.pathname;
const nav = [
  ["/", "Homepage"],
  ["/ueber-mich", "Über mich"],
  ["/hobbies", "Hobbies"],
  ["/software", "Software"],
  ["/hilat-al-bir", "Hilat Al Bir"],
];
---

<header class="site-header">
  <div class="container bar">
    <div class="brand">
      <Image
        src={clausNeon}
        alt="Claus Schiroky"
        width={112}
        height={112}
        format="webp"
        quality={80}
        loading="eager"
      />
      <span>Claus Schiroky</span>
    </div>
    <button class="menu" aria-label="Navigation öffnen" aria-expanded="false"
      >Menü</button
    >
    <nav aria-label="Hauptnavigation">
      {
        nav.map(([href, label]) => (
          <a class={path === href ? "active" : ""} href={href}>
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector(".menu");
  const nav = document.querySelector(".site-header nav");
  button?.addEventListener("click", () => {
    const open = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("open", !open);
  });
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgba(5, 6, 10, 0.72);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0, 245, 255, 0.1);
  }
  .bar {
    height: 72px;
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 56px;
    color: #ff2d95;
    font-weight: 800;
  }
  .brand img {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }
  nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  nav a {
    color: var(--cyan);
    padding: 0.58rem 0.72rem;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 700;
  }
  nav a:hover {
    color: var(--pink);
    background: rgba(255, 45, 149, 0.07);
    text-shadow: 0 0 14px rgba(255, 45, 149, 0.8);
  }
  nav a.active {
    color: #fff;
    background: rgba(0, 245, 255, 0.07);
    text-shadow: none;
    box-shadow: inset 0 -1px 0 var(--cyan);
  }
  .menu {
    display: none;
    margin-left: auto;
    background: transparent;
    color: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.55rem 0.75rem;
  }
  @media (max-width: 820px) {
    .menu {
      display: block;
    }
    nav {
      display: none;
      position: absolute;
      top: 72px;
      left: 18px;
      right: 18px;
      padding: 0.75rem;
      flex-direction: column;
      align-items: stretch;
      background: rgba(10, 13, 20, 0.97);
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    }
    nav.open {
      display: flex;
    }
  }
</style>
